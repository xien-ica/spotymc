{
	"schemaVersion": 1,
	"id": "spotymc",
	"version": "${version}",
	"name": "SpotyMC",
	"description": "Brings Spotify Connect and real-time synced lyrics into Minecraft, so you can see what's playing and control playback without alt-tabbing out of the game.",
	"authors": [
		"xien-ica"
	],
	"contact": {
		"homepage": "https://github.com/xien-ica/spotymc",
		"sources": "https://github.com/xien-ica/spotymc"
	},
	"license": "CC0-1.0",
	"icon": "assets/spotymc/icon2.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"xien.jxsh.spotymc.Spotymc"
		]
	},
	"mixins": [
		"spotymc.mixins.json",
		{
			"config": "spotymc.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}